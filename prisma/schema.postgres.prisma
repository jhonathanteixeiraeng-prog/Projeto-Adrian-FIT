// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTHENTICATION
// ==========================================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  // Last "esqueci minha senha" e-mail: at most one every few minutes per account (src/lib/password-reset.ts).
  passwordResetSentAt DateTime?
  role      String   @default("STUDENT") // PERSONAL | STUDENT
  phone     String?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  personal         Personal?
  student          Student?
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  notifications    Notification[]
}

// ==========================================
// PERSONAL TRAINER PROFILE
// ==========================================

model Personal {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName String?
  bio       String?
  createdAt DateTime @default(now())

  students         Student[]
  workoutPlans     WorkoutPlan[]
  dietPlans        DietPlan[]
  dietTemplates    DietTemplate[]
  exercises        Exercise[]
  workoutTemplates WorkoutTemplate[]
}

// ==========================================
// STUDENT PROFILE
// ==========================================

model Student {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalId String
  personal   Personal  @relation(fields: [personalId], references: [id])
  birthDate  DateTime?
  gender     String? // MALE | FEMALE | OTHER
  height     Float? // em cm
  weight     Float? // em kg
  goal           String?
  // Trainer's opinion on the evolution report (printed and sent in the report PDF).
  reportOpinion  String?
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE | PAUSED
  /// Uses the student area / app (phase 2 pilot, src/lib/student-app.ts). Off: plans go as PDF over WhatsApp.
  usesApp        Boolean   @default(false)
  /// When usesApp was last turned on: app activity (workouts, check-ins) counts from then, not from before.
  usesAppSince   DateTime?
  planType       String?   @default("MENSAL") // MENSAL | TRIMESTRAL | SEMESTRAL | ANUAL
  planValue      Float?    @default(150.0) // Valor em R$
  planExpiresAt  DateTime? // Data de vencimento da consultoria
  paymentStatus  String?   @default("PAID") // PAID | PENDING | OVERDUE
  createdAt      DateTime  @default(now())

  anamnesis         Anamnesis?
  workoutPlans      WorkoutPlan[]
  dietPlans         DietPlan[]
  checkins          Checkin[]
  progressPhotos    ProgressPhoto[]
  assessments       Assessment[]
  foodSubstitutions FoodSubstitutionHistory[]
  setLogs           SetLog[]
  workoutSessions   WorkoutSession[]
}

// ==========================================
// ANAMNESIS (Health History)
// ==========================================

model Anamnesis {
  id            String   @id @default(cuid())
  studentId     String   @unique
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  restrictions  String? // Restrições alimentares
  injuries      String? // Lesões
  medications   String? // Medicamentos
  activityLevel String // SEDENTARY | LIGHT | MODERATE | ACTIVE | VERY_ACTIVE
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==========================================
// WORKOUT PLAN & EXERCISES
// ==========================================

model WorkoutPlan {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  personalId String
  personal   Personal @relation(fields: [personalId], references: [id])
  title      String
  startDate  DateTime
  endDate    DateTime
  version    Int      @default(1)
  active     Boolean  @default(true)
  // Last PDF the trainer sent (exported) and the plan version it had; version > sentVersion = changed since.
  sentAt      DateTime?
  sentVersion Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  workoutDays WorkoutDay[]
}

model WorkoutDay {
  id        String      @id @default(cuid())
  planId    String
  plan      WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Dom, 1=Seg, ..., 6=Sab
  name      String // "Treino A - Peito e Tríceps"
  order     Int         @default(0)

  items       WorkoutItem[]
  completions WorkoutCompletion[]
}

model WorkoutTemplate {
  id          String   @id @default(cuid())
  personalId  String
  personal    Personal @relation(fields: [personalId], references: [id])
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  templateDays WorkoutTemplateDay[]
}

model WorkoutTemplateDay {
  id         String          @id @default(cuid())
  templateId String
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  dayOfWeek  Int // 0=Dom, 1=Seg, ..., 6=Sab
  name       String // "Treino A - Peito e Tríceps"
  order      Int             @default(0)

  items WorkoutTemplateItem[]
}

model WorkoutTemplateItem {
  id            String             @id @default(cuid())
  templateDayId String
  templateDay   WorkoutTemplateDay @relation(fields: [templateDayId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      Exercise           @relation(fields: [exerciseId], references: [id])
  sets          Int
  reps          String
  rest          Int
  restBySet     String? // JSON com descanso individual por série
  load          String? // Carga prescrita em kg: "20" ou por série "20/22.5/25"
  rpe           String? // Intensidade prescrita (RPE 1-10): "8" ou "7-8"
  groupId       String? // Bi-set/tri-set: exercícios consecutivos do dia com o mesmo groupId
  notes         String?
  order         Int                @default(0)
}

model Exercise {
  id           String    @id @default(cuid())
  personalId   String?
  personal     Personal? @relation(fields: [personalId], references: [id])
  name         String
  muscleGroup  String
  equipment    String?
  difficulty   String    @default("INICIANTE") // INICIANTE | INTERMEDIARIO | AVANCADO
  videoUrl     String?
  thumbnailUrl String?
  instructions String?
  tips         String?
  createdAt    DateTime  @default(now())

  workoutItems         WorkoutItem[]
  workoutTemplateItems WorkoutTemplateItem[]
  setLogs              SetLog[]

  // Unique within each trainer's private library. Global exercises (personalId null) come from the seed,
  // which checks their names itself; creating one compares names ignoring case and accents with the
  // global and own exercises (isExerciseNameTaken).
  @@unique([personalId, name])
}

model WorkoutItem {
  id           String     @id @default(cuid())
  workoutDayId String
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exerciseId   String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  sets         Int // Número de séries
  reps         String // "10-12" ou "15"
  rest         Int // Segundos de descanso
  restBySet    String? // JSON com descanso individual por série
  load         String? // Carga prescrita em kg: "20" ou por série "20/22.5/25"
  rpe          String? // Intensidade prescrita (RPE 1-10): "8" ou "7-8"
  groupId      String? // Bi-set/tri-set: exercícios consecutivos do dia com o mesmo groupId
  notes        String?
  order        Int        @default(0)
}

model WorkoutCompletion {
  id           String     @id @default(cuid())
  workoutDayId String
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  studentId    String
  completedAt  DateTime   @default(now())

  @@unique([workoutDayId, studentId, completedAt])
}

/// Sessão detalhada e sincronizada de um treino. Mantém snapshots do treino
/// para que o histórico sobreviva a alterações futuras no plano.
model WorkoutSession {
  id              String   @id @default(cuid())
  studentId       String
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  workoutDayId    String
  dayName         String
  localDate       String
  status          String // PARTIAL | COMPLETED
  startedAt       DateTime
  completedAt     DateTime @default(now())
  completedSets   Int
  totalSets       Int
  percentage      Int
  durationSeconds Int
  totalVolume     Float    @default(0)
  activeEnergyKilocalories Float?
  averageHeartRateBPM      Float?
  maxHeartRateBPM          Float?
  healthWorkoutUUID        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  setLogs SetLog[]

  @@unique([studentId, workoutDayId, localDate])
  @@index([studentId, completedAt])
  @@index([studentId, workoutDayId])
}

// ==========================================
// DIET PLAN & MEALS
// ==========================================

model DietPlan {
  id         String    @id @default(cuid())
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  personalId String
  personal   Personal  @relation(fields: [personalId], references: [id])
  title      String
  startDate  DateTime?
  endDate    DateTime?
  calories   Int?
  protein    Int? // gramas
  carbs      Int? // gramas
  fat        Int? // gramas
  version    Int       @default(1)
  active     Boolean   @default(true)
  // Last PDF the trainer sent (exported) and the plan version it had; version > sentVersion = changed since.
  sentAt      DateTime?
  sentVersion Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  meals DietMeal[]
}

model DietMeal {
  id         String   @id @default(cuid())
  dietPlanId String
  dietPlan   DietPlan @relation(fields: [dietPlanId], references: [id], onDelete: Cascade)
  name       String // "Café da manhã", "Almoço", etc.
  time       String // "07:00"
  foods      String // JSON string com lista de alimentos
  notes      String?
  order      Int      @default(0)

  completions MealCompletion[]
}

model MealCompletion {
  id          String   @id @default(cuid())
  mealId      String
  meal        DietMeal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  studentId   String
  completedAt DateTime @default(now())

  @@unique([mealId, studentId, completedAt])
}

model SetLog {
  id         String          @id @default(cuid())
  studentId  String
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  dayId      String // WorkoutDay usado para agrupar a sessão
  setIndex   Int
  weight     Float // kg (0 = peso corporal)
  reps       Int
  date       DateTime        @default(now())
  /// The student's calendar day (YYYY-MM-DD, see src/lib/student-day.ts). Null on logs saved before it existed.
  localDate  String?
  sessionId  String?
  session    WorkoutSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // One log per set and day: a repeated or concurrent save updates it instead of adding another (audit A13).
  @@unique([studentId, dayId, exerciseId, setIndex, localDate])
  @@index([studentId, exerciseId, date])
  @@index([studentId, dayId, date])
  @@index([sessionId])
}

// ==========================================
// CHECK-INS & PROGRESS
// ==========================================

model Checkin {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date             DateTime @default(now())
  weight           Float // kg
  sleepHours       Float // horas
  energyLevel      Int // 1-5
  hungerLevel      Int // 1-5
  stressLevel      Int // 1-5
  workoutAdherence Int // 0-100%
  dietAdherence    Int // 0-100%
  notes            String?

  // Medidas corporais (em centímetros)
  chest            Float? // Tórax / Peitoral
  waist            Float? // Cintura
  abdomen          Float? // Abdômen
  hips             Float? // Quadril
  armRight         Float? // Braço direito
  armLeft          Float? // Braço esquerdo
  thighRight       Float? // Coxa direita
  thighLeft        Float? // Coxa esquerda
  calfRight        Float? // Panturrilha direita
  calfLeft         Float? // Panturrilha esquerda
  bodyFatPercentage Float? // % de gordura corporal

  photos           ProgressPhoto[]

  @@index([studentId, date])
}

model ProgressPhoto {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checkinId String?
  checkin   Checkin? @relation(fields: [checkinId], references: [id], onDelete: SetNull)
  // Photo taken in an assessment the trainer recorded (see Assessment).
  assessmentId String?
  assessment   Assessment? @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  url       String
  angle     String // FRONT | SIDE | BACK | OTHER
  weight    Float? // snapshot de peso no momento da foto
  notes     String?
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([studentId, angle])
  @@index([checkinId])
  @@index([assessmentId])
}

// Physical assessment the trainer records (weight, body fat, circumferences, photos).
// Separate from Checkin, which is the student's self-report in the app (sleep, adherence…);
// the iOS app decodes check-ins with those fields required.
model Assessment {
  id                String   @id @default(cuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date              DateTime
  weight            Float? // kg
  bodyFatPercentage Float? // % de gordura corporal
  chest             Float? // Tórax / peitoral (cm)
  waist             Float? // Cintura
  abdomen           Float? // Abdômen
  hips              Float? // Quadril
  armRight          Float? // Braço direito
  armLeft           Float? // Braço esquerdo
  thighRight        Float? // Coxa direita
  thighLeft         Float? // Coxa esquerda
  calfRight         Float? // Panturrilha direita
  calfLeft          Float? // Panturrilha esquerda
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  photos ProgressPhoto[]

  @@index([studentId, date])
}

// ==========================================
// MESSAGING
// ==========================================

model Message {
  id         String   @id @default(cuid())
  fromUserId String
  fromUser   User     @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
  text       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // WORKOUT_REMINDER | MEAL_REMINDER | CHECKIN_REMINDER | PLAN_UPDATED | LOW_ADHERENCE | NEW_MESSAGE
  title     String
  body      String
  link      String? // In-app route opened when the notification is clicked (e.g. /personal/chat/<studentId>)
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ==========================================
// FOOD DATABASE
// ==========================================

model Food {
  id       String  @id @default(cuid())
  name     String
  portion  String  @default("100g")
  calories Float
  protein  Float
  carbs    Float
  fat      Float
  isSystem Boolean @default(false)

  // Optional: tracking who created/imported it
  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FoodSubstitutionHistory {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mealId         String
  originalFood   String // Name of original food
  originalAmount String // e.g. "100g"
  newFood        String // Name of new food
  newAmount      String // e.g. "150g"
  caloriesDiff   Float? // Difference in calories
  createdAt      DateTime @default(now())
}

// ==========================================
// DIET TEMPLATES
// ==========================================

model DietTemplate {
  id         String   @id @default(cuid())
  personalId String
  personal   Personal @relation(fields: [personalId], references: [id])
  title      String
  calories   Int?
  protein    Int? // gramas
  carbs      Int? // gramas
  fat        Int? // gramas
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  meals DietTemplateMeal[]
}

model DietTemplateMeal {
  id         String       @id @default(cuid())
  templateId String
  template   DietTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name       String
  time       String
  foods      String // JSON string
  notes      String?
  order      Int          @default(0)
}

/// Usage limits (src/lib/rate-limit.ts): one fixed-window counter per operation and caller. The key is a
/// hash, so no e-mail or IP address is stored.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}
